API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=fundo-foundation-ultra-secure-key-2026-production-ready-jwt-secret-998877
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
